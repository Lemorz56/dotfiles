[user]
	name = Sebastian Mossberg
	email = sebastian.mossberg@epiroc.com
[credential]
	#useHttpPath = true
    ; helper = /mnt/c/Users/tmgsemo/AppData/Local/Programs/Git/mingw64/libexec/git-core/git-credential-manager-core.exe
    ;helper = manager
	; credentialStore = gpg
	helper = osxkeychain
	azreposCredentialType = oauth
	gitHubAccountFiltering = false
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
	; helper = 
    #helper = '/mnt/c/git/git-credential-manager.exe'

[pull]
	rebase = true
[push]
    default = current
    followTags = true
[rebase]
	autostash = true
[alias]
	graph = log --oneline --graph --decorate
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	lds = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
	conflicts = diff --name-only --diff-filter=U
	local-branches = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'
	; recent-branches = !git branch --sort=-committerdate | head
	authors = !git log --format='%aN <%aE>' | grep -v 'users.noreply.github.com' | sort -u --ignore-case
    configure = "config --global -e"
    lg = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --no-merges"
	pl = pull
	pu = push
	diffile = "!f() {git diff-tree --no-commit-id --name-only $1 -r}; f"
    # Output the current branch name
    get-branch = !git rev-parse --abbrev-ref HEAD
    # Shortcut to push to the current branch and set it to track the upstream branch.
    publish = !git push -u origin $(git get-branch)
    # Shortcut to add, commit and push in one command.
    rocket = "!f() { git add . && git commit -m \"$1\" && $(git publish); }; f"
    st = status
    difft = -c diff.external=difft diff
    w = worktree
[alias]
    # Difftastic aliases, so `git dlog` is `git log` with difftastic and so on.
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
[safe]
	directory = /home/tmgsemo/code/azure-storage-fuse
[core]
    editor = nvim
    ignorecase = false
    excludesfile = ~/.gitignore
    preloadindex = true
    fscache = true
    symlinks = true
    autocrlf = input
    filemode = false
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
[color]
    branch  = auto
    diff    = auto
    status  = auto
    ui      = always
[color "branch"]
    current = red reverse
    local   = blue
    remote  = green
[color "diff"]
    meta    = yellow
    frag    = magenta
    old     = red bold
    new     = green
    plain   = white
[color "status"]
    added       = yellow
    changed     = green
    untracked   = cyan
[pager]
    #diff = diff-so-fancy | bat
	diff = delta
    #show = diff-so-fancy | bat
	show = delta
[diff "astextplain"]
    textconv = astextplain
; [diff]
;     tool = default-difftool
;     mnemonicprefix = true
; [difftool "default-difftool"]
;     cmd = code --diff $LOCAL $REMOTE
;     prompt = false
[merge]
    conflictstyle = "diff3"
[branch]
    autosetuprebase = always
[apply]
    whitespace = nowarn
[rerere]
    enabled = false
; [http]
;     sslVerify = true
[init]
    defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "azrepos:org/epiroc-it"]
	azureAuthority = https://login.microsoftonline.com/896ecbea-bd27-4a3c-a131-34aa0b46a086
	username = sebastian.mossberg@epiroc.com
[credential "azrepos:org/EPIROC-AUTOMATION"]
	username = sebastian.mossberg@epiroc.com
	azureAuthority = https://login.microsoftonline.com/896ecbea-bd27-4a3c-a131-34aa0b46a086
[credential "https://dev.azure.com"]
	useHttpPath = true
